<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="相册动态壁纸"
            android:textColor="@color/text_main"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="随机轮播 · 手动同步 · 亮屏换图"
            android:textColor="@color/text_sub"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card"
            android:lineSpacingExtra="5dp"
            android:padding="16dp"
            android:textColor="@color/text_main"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_folder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:textColor="@color/text_sub"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_folder"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_button"
            android:text="① 选择相册文件夹"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btn_sync"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_button"
            android:text="② 手动同步"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="③ 切换间隔"
            android:textColor="@color/text_main"
            android:textSize="15sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rg_interval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rb_30"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="30 秒"
                android:textColor="@color/text_main"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/rb_60"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="60 秒"
                android:textColor="@color/text_main"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/rb_120"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="120 秒"
                android:textColor="@color/text_main"
                android:textSize="14sp" />
        </RadioGroup>

        <Switch
            android:id="@+id/sw_ball"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="④ 桌面悬浮球（单击换一张，可拖动）"
            android:textColor="@color/text_main"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_set_wallpaper"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button"
                android:text="设为壁纸"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_settings"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button"
                android:text="权限与保活设置"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:lineSpacingExtra="4dp"
            android:text="说明：只有点「手动同步」才会扫描相册（首次选择文件夹时会自动全量导入一次）。\n息屏后亮屏并解锁，自动随机换一张。\n悬浮球只在桌面显示，进入其他 App 自动隐藏。"
            android:textColor="@color/text_sub"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
